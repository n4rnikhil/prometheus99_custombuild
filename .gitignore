report*.txt
measure_output.txt
*.tmp
*.bak

# Python caches (from tests/ simulators)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/


# IDE & OS metadata
.vscode/
.vs/
.idea/
*.suo
*.user
Thumbs.db
Desktop.ini
.DS_Store

