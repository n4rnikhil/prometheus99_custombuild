# 1 ms FreeRTOS tick: the fieldbus loop paces itself in whole ticks
CONFIG_FREERTOS_HZ=1000

# RGB panel frame buffer lives in PSRAM (800 x 480 x 2 bytes = 750 KB)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# UI loop (rendering, alarm log, report) runs in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Modbus TCP: device slots + parallel discovery probes need sockets
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y
