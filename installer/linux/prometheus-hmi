#!/bin/sh
# Prometheus HMI launcher (Linux): keeps the site's settings, log, key and vault in the user's
# data folder, not next to the program. Extra options are passed to the HMI.
APP_DIR="$(dirname "$(readlink -f "$0")")"   # the real folder, also when started through a link
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/prometheus-hmi"
mkdir -p "$DATA" && chmod 700 "$DATA"
[ -f "$DATA/hmi.cfg" ] || cp "$APP_DIR/hmi.cfg" "$DATA/hmi.cfg"
"$APP_DIR/industrial_hmi" --config "$DATA/hmi.cfg" --log "$DATA/alarms.log" \
     --key "$DATA/hmi.key" --vault "$DATA/security.vault" "$@"
rc=$?
if [ "$rc" -eq 4 ]; then                     # already running: show that one instead
    if command -v wmctrl >/dev/null 2>&1; then wmctrl -x -a Prometheus-HMI 2>/dev/null
    elif command -v xdotool >/dev/null 2>&1; then xdotool search --class Prometheus-HMI windowactivate 2>/dev/null
    fi
    [ -t 2 ] || { command -v notify-send >/dev/null 2>&1 && notify-send "Prometheus HMI" "Prometheus HMI is already running."; }
fi
exit "$rc"
